{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Bash(git add:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  },
  "effortLevel": "high",
  "tui": "default",
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true,
  "preferredNotifChannel": "notifications_disabled",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/claude-attn.sh notification" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/claude-attn.sh stop" }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/claude-attn.sh stop_failure" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/claude-attn.sh prompt_submit" }
        ]
      }
    ]
  }
}
